# Explicit operational profile, not an automatically installed global policy.
@prefix q: <https://scbrown.github.io/quechua/ns#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# An unrelated Event/Action is not a scheduled job. Only eventSchedule selects
# the operational declaration constraints below. This type target declares the
# standard class without adding scheduling requirements to unrelated events.
q:ScheduledEventTypeShape a sh:NodeShape ; sh:targetClass schema:Event .

q:ScheduledJobEventShape a sh:NodeShape ;
    sh:targetSubjectsOf schema:eventSchedule ;
    sh:class schema:Event ;
    sh:property [ sh:path schema:eventSchedule ; sh:minCount 1 ;
        sh:nodeKind sh:IRI ; sh:class schema:Schedule ] ;
    sh:property [ sh:path schema:potentialAction ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ; sh:class schema:Action ; sh:node q:ScheduledJobActionShape ] ;
    # Schema.org puts these on the Schedule to avoid ambiguous bounds.
    sh:property [ sh:path schema:startDate ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:endDate ; sh:maxCount 0 ] .

q:ScheduledJobActionShape a sh:NodeShape ;
    sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path schema:identifier ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path q:sourceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("declared") ] ;
    sh:property [ sh:path q:owner ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path q:enabled ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path schema:location ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

# Positive fixed intervals or one weekly local weekday/time. Consumers validate
# IANA zones and anchor alignment; calendar qualifiers never mean elapsed weeks.
q:RecurringJobScheduleShape a sh:NodeShape ;
    sh:targetClass schema:Schedule ;
    sh:property [ sh:path schema:repeatFrequency ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:duration ;
        sh:pattern "^P([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$" ] ;
    sh:property [ sh:path schema:repeatFrequency ; sh:pattern "[1-9]" ] ;
    sh:property [ sh:path schema:scheduleTimezone ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path schema:startDate ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
    sh:or (
        [ sh:property [ sh:path schema:byDay ; sh:maxCount 0 ] ;
          sh:property [ sh:path schema:startTime ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:repeatFrequency ;
              sh:hasValue "P7D"^^xsd:duration ] ;
          sh:property [ sh:path schema:byDay ; sh:minCount 1 ; sh:maxCount 1 ;
              sh:nodeKind sh:IRI ; sh:in (schema:Monday schema:Tuesday
                  schema:Wednesday schema:Thursday schema:Friday schema:Saturday schema:Sunday) ] ;
          sh:property [ sh:path schema:startTime ; sh:minCount 1 ; sh:maxCount 1 ;
              sh:datatype xsd:time ; sh:pattern "^([01][0-9]|2[0-3]):[0-5][0-9]:00$" ] ]
    ) ;
    sh:property [ sh:path schema:byMonth ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:byMonthDay ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:byMonthWeek ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:exceptDate ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:repeatCount ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:endTime ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:endDate ; sh:maxCount 0 ] .
